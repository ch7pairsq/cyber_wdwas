{
  "schema_version": 1,
  "description": "离线 CTF 工具链清单：构建期安装，运行期只调用；版本与许可由包管理器及镜像内 copyright 固化。",
  "policy": {
    "install_phase": "docker-build",
    "runtime_install": false,
    "runtime_download": false,
    "runtime_network": false,
    "package_sources": [
      "debian-apt-official"
    ],
    "notes": "比赛容器不得执行 pip/apt/uv/npm；工具必须来自基础镜像或构建期 apt。"
  },
  "tiers": [
    "core",
    "ctf",
    "optional"
  ],
  "tools": [
    {
      "name": "file",
      "package": "file",
      "source": "apt",
      "bins": [
        "file"
      ],
      "tier": "core",
      "installed_by_default": true,
      "allowlist": true,
      "risk": "read",
      "license": "BSD-2-Clause",
      "notes": "文件类型识别"
    },
    {
      "name": "binutils",
      "package": "binutils",
      "source": "apt",
      "bins": [
        "strings",
        "objdump",
        "readelf",
        "nm"
      ],
      "tier": "core",
      "installed_by_default": true,
      "allowlist": true,
      "risk": "read",
      "license": "GPL-3.0-or-later",
      "notes": "strings/objdump/readelf/nm"
    },
    {
      "name": "unzip",
      "package": "unzip",
      "source": "apt",
      "bins": [
        "unzip"
      ],
      "tier": "core",
      "installed_by_default": true,
      "allowlist": true,
      "risk": "read",
      "license": "Info-ZIP",
      "notes": "ZIP 解压"
    },
    {
